# Bind address
HOST=127.0.0.1
PORT=8088

# Shared secret — App sendet Header X-ScooterCheck-Token
API_TOKEN=change-me

# Decrypt: absolute path to YOUR wrapper that calls the already-installed tool.
# Invoked as:  $DECRYPT_CMD <input.enc> <output.bin>
# Exit 0 + non-empty output.bin = success. Keys stay only inside your wrapper/vault.
DECRYPT_CMD=/opt/scootercheck/decrypt-firm.sh

# Working directory for jobs (created if missing)
WORK_DIR=/var/lib/scootercheck/firmware-jobs

# Optional: delete job dirs after N hours (0 = keep)
JOB_RETENTION_HOURS=24

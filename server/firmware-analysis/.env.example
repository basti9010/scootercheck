# Bind address
HOST=127.0.0.1
PORT=8088

# Shared secret — App sendet Header X-ScooterCheck-Token
API_TOKEN=change-me

# Decrypt wrapper (calls already-installed ninebottea). Args: <input.enc> <output.bin>
DECRYPT_CMD=/opt/scootercheck/decrypt-firm.sh

# Job workspace + durable stores
WORK_DIR=/var/lib/scootercheck/firmware-jobs
PLAINTEXT_STORE=/var/lib/scootercheck/decrypted
DECOMPILE_STORE=/var/lib/scootercheck/decompiled

# Ghidra headless (install Ghidra on the VPS, then set one of these)
# GHIDRA_HOME=/opt/ghidra
# GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
ENABLE_GHIDRA=1
GHIDRA_PROCESSOR=ARM:LE:32:Cortex
GHIDRA_BASE_ADDR=0x08000000

# Optional: delete job dirs after N hours (0 = keep)
JOB_RETENTION_HOURS=24

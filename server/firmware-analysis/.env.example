HOST=127.0.0.1
PORT=8088

# Shared secret — App optional Header X-ScooterCheck-Token (user/API calls only).
API_TOKEN=change-me
# Dedicated admin token (required for admin endpoints when grants are off).
# Always set in prod — do not rely on shared API_TOKEN for admin.
ADMIN_API_TOKEN=change-me-admin
# Phase 2.2H / Cycle 10 secure default: shared API_TOKEN does NOT grant admin.
# MUST stay 0 in prod/staging/defaults/tests. Setting 1 → authSecurityOk=false (CRITICAL).
API_TOKEN_GRANTS_ADMIN=0
# Legacy compat only (discouraged — collapses user vs admin): API_TOKEN_GRANTS_ADMIN=1
# Phase 2.2H.1: Client-Id must NOT own jobs under shared API_TOKEN (spoofable).
TRUST_API_TOKEN_CLIENT_ID=0
# Legacy only: TRUST_API_TOKEN_CLIENT_ID=1 (discouraged — prefer Bearer JWT)

# Same secret as ScooterCheck Auth (/opt/scootercheck/.env) for Bearer JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

DECRYPT_CMD=/opt/scootercheck/decrypt-firm.sh

WORK_DIR=/var/lib/scootercheck/firmware-jobs
PLAINTEXT_STORE=/var/lib/scootercheck/decrypted
DECOMPILE_STORE=/var/lib/scootercheck/decompiled

GHIDRA_HOME=/opt/ghidra
ENABLE_GHIDRA=1
GHIDRA_PROCESSOR=ARM:LE:32:Cortex
GHIDRA_BASE_ADDR=0x08000000
# GHIDRA_AUTO_IDENTIFY=1
# GHIDRA_SEED_IVT=1

# Storage policy: keep finished jobs this many days; soft cap on total jobs.
JOB_RETENTION_DAYS=30
MAX_STORED_JOBS=500

# Optional schema-bound LLM. Without key, allowLLM is a no-op.
# OpenAI-compatible:
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
# Anthropic (Claude Console API key — sk-ant-...):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_MODEL=claude-haiku-4-5-20251001
# LLM_API_KEY=
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_MODEL=

# Stock firmware library for byte-diff after decrypt
STOCK_FW_DIR=/var/lib/scootercheck/stock-fw

# angr CFGFast in isolated subprocess (no symbolic execution)
# ENABLE_ANGR=1
# ANGR_MAX_BYTES=262144
# ANGR_TIMEOUT_SEC=90
# ANGR_MEM_MB=1800

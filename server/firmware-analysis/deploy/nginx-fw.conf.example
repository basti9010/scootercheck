# TLS reverse proxy example (Hetzner VPS + Let's Encrypt).
# Replace fw.example.de with your hostname.
server {
    listen 443 ssl http2;
    server_name fw.example.de;

    # ssl_certificate     /etc/letsencrypt/live/fw.example.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/fw.example.de/privkey.pem;

    client_max_body_size 80m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
